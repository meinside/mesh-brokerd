# brokerd secrets (docs/security.md §7). Copy this file to .env and replace
# every <PLACEHOLDER> — .env itself is gitignored and must never be
# committed. Each value below is referenced by name (not value) from
# config.json's *_env keys (docs/brokerd-config.md).
#
# One entry carries a real value rather than a placeholder, and says why:
# the public MQTT server's password is a published firmware constant, so
# hiding it would only make it harder to use. Anything shown as
# <PLACEHOLDER> is genuinely secret.

# ADR-8 (docs/adr.md): DNS-01 provider credentials, read directly by
# the go-acme/lego provider itself — the env var *name* is fixed by
# the provider you select (listener.tls_dns_provider), not
# configurable. For "cloudflare" (this project's provider), create an
# API token scoped to Zone:Read + DNS:Edit on the one zone (never
# account-wide), then set it here. This one is issued by the provider, so
# brokerd-keygen cannot make it:
CLOUDFLARE_DNS_API_TOKEN="<PLACEHOLDER>"
# See https://go-acme.github.io/lego/dns/ for other providers'
# required variables if this is ever run against a different one.

# bcrypt hashes (never plaintext passwords) for each board account
# (docs/security.md §3). Generate one per board:
#   go run ./cmd/brokerd-keygen -bcrypt
# The password you type goes on the board as mqtt.password, which the firmware
# caps at 31 usable characters (docs/firmware-config.md section 12) -- pick it
# within that limit or the board silently truncates and authentication fails.
BROKERD_BOARD_ALPHA_PASSWORD_HASH="<PLACEHOLDER>"
BROKERD_BOARD_BRAVO_PASSWORD_HASH="<PLACEHOLDER>"

# The private channel's 32-byte PSK, standard base64 with padding (ADR-11).
# Either copy it out of the Meshtastic app/CLI with no re-encoding, or generate
# one here and paste it into both sides unchanged:
#   go run ./cmd/brokerd-keygen -psk
BROKERD_CHANNEL_PRVTCHN_PSK="<PLACEHOLDER>"

# Bearer token for the read-only monitoring API (docs/monitoring-api.md §2):
#   go run ./cmd/brokerd-keygen -token
BROKERD_MONITORING_TOKEN="<PLACEHOLDER>"

# Password for outbound_relay.targets[].password_env.
#
# Spelled out rather than left as a placeholder, because it is NOT a secret:
# it is the Meshtastic firmware's own published constant, defined as
# default_mqtt_password in src/mesh/Default.h and copied into every device's
# initial configuration by NodeDB.cpp. Every unconfigured board on earth
# already has it (docs/outbound-relay.md section 6.1).
#
# It still arrives via an env var so that credentials always reach brokerd the
# same way, and nobody has to judge per target whether a password counts as
# secret -- a second target, such as a private community broker, would carry a
# real one (docs/security.md section 7).
BROKERD_RELAY_PUBLIC_PASSWORD='large4cats'

# Event hooks (docs/event-hooks.md). Only needed for a webhook target; a
# command target needs no secret. The URL is a secret too: it usually
# contains a bot token or a per-user path.
BROKERD_HOOK_PHONE_URL='<https URL of the webhook receiver>'
BROKERD_HOOK_PHONE_SECRET='<random string; the receiver verifies X-Brokerd-Signature with it>'

